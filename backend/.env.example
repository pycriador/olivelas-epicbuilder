# AIOPS App Model API — copy to .env (never commit .env)

# --- Application runtime (generated by scripts/provision_rds.py) ---
DATABASE_URL=postgresql+asyncpg://APP_USER:APP_PASSWORD@HOST:5432/aiops_app_model
DB_HOST=HOST
DB_PORT=5432
DB_NAME=aiops_app_model
DB_USER=aiops_app_model_app
DB_PASSWORD=
DB_SCHEMA=portal

# TLS — see repository root .env (DB_SSLMODE / DB_SSL_INSECURE for Netskope dev)
DB_SSLMODE=require
# DB_SSL_INSECURE=true

APP_NAME=AIOPS App Model API
# Local origins + published fronts (scheme+host, no trailing slash).
# Canonical corp/Cross URLs: deploy/published-hosts.env (CORP_FRONT_URL, CROSS_FRONT_URL).
# Production Vault should list at least CORP_FRONT_URL.
# Optional during cutover: CROSS_FRONT_URL.
# Changing CORS requires an API process restart (middleware is built at startup).
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:8080,https://aiops-app-model.loft-corp.com.br,https://aiops-app-model-front.cross.loft-prod.io

# --- External integrations (also readable from repository root .env) ---
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
CONFLUENCE_STATUS_FOLDER_ID=

# --- Admin credentials (repository root .env only — NOT this file) ---
# Used by scripts/provision_rds.py, run_migrations.py, grant_app_privileges.py
# DB_HOST / DB_USER=postgres / DB_PASSWORD from infra team

# --- IAM (never commit real secrets) ---
JWT_SECRET=dev-only-change-me-replace-before-prod-32chars
# Optional dedicated Fernet key for iam.runtime_settings (falls back to JWT_SECRET)
# SETTINGS_ENCRYPTION_KEY=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
JWT_REFRESH_REMEMBER_DAYS=30
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
EXPOSE_DEV_TOKENS=true
REQUIRE_AUTH=true
IAM_ADMIN_EMAIL=admin@loft.local
IAM_ADMIN_USERNAME=admin
IAM_ADMIN_PASSWORD=ChangeMe123!

# Integration vars below can also be managed in Admin → Configurações (encrypted in DB).
# Bootstrap-only secrets stay here: DATABASE_*, JWT_SECRET, SETTINGS_ENCRYPTION_KEY.
