# ─────────────────────────────────────────────
# AIOPS App Model — variáveis de ambiente
# Copie este arquivo para `.env` e preencha os valores.
# O `.env` é ignorado pelo git (nunca comitar credenciais).
# ─────────────────────────────────────────────

# --- Backend (FastAPI) -----------------------
# URL base do backend (local / SSR fallback). Em produção o browser escolhe a API
# pelo hostname do front (VITE_CORP_* / VITE_CROSS_* bakeados no Docker).
VITE_API_URL=http://localhost:8000
# Opcional em local (só necessário se testar o mapa de origins):
# VITE_CORP_API_URL=https://aiops-app-model-api.loft-corp.com.br
# VITE_CROSS_API_URL=https://aiops-app-model-api.cross.loft-prod.io
# VITE_CORP_FRONT_URL=https://aiops-app-model.loft-corp.com.br
# VITE_CROSS_FRONT_URL=https://aiops-app-model-front.cross.loft-prod.io

# --- RDS admin (bootstrap: provision + migrations only) ---
# Credenciais de admin ficam aqui; runtime da API usa backend/.env (role aiops_app_model_app)
DB_HOST=
DB_PORT=5432
DB_NAME=aiops
DB_USER=postgres
DB_PASSWORD=

# TLS para RDS (CA interna Loft / Netskope em dev local)
DB_SSLMODE=require
# DB_SSL_ROOT_CERT=/caminho/para/ca-bundle.pem
# DB_SSL_INSECURE=true   # dev local com Netskope — Postgres + Jira/Gemini (HTTPS)
# HTTP_SSL_INSECURE=true # só chamadas HTTPS (alternativa à linha acima)

# Não use estas variáveis para runtime da API após provisionamento:
# DATABASE_URL / DB_* da aplicação ficam em backend/.env (gerado por scripts/provision_rds.py)

# --- Jira / Gemini / Confluence ----------------
# Fallback when not overridden in Admin → Configurações (encrypted in DB).
# Ex.: https://sua-empresa.atlassian.net
JIRA_BASE_URL=
JIRA_EMAIL=
# API token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
CONFLUENCE_STATUS_FOLDER_ID=

# Optional: dedicated encryption key for runtime settings (else JWT_SECRET)
# SETTINGS_ENCRYPTION_KEY=
