#!/bin/sh
# Minimal front entrypoint for Nitro node-server output (.output/server/index.mjs)
# Copy to: docker/entrypoint.sh  (chmod +x)

set -e

export PORT="${PORT:-8080}"
export HOST="${HOST:-0.0.0.0}"

# Node 24 ESM: use dd-trace/init.js. Strip conflicting NODE_OPTIONS imports.
if [ -n "${NODE_OPTIONS:-}" ]; then
  NODE_OPTIONS=$(printf '%s' "$NODE_OPTIONS" | sed -E 's/--import[= ]*dd-trace\/init(\.js)?//g' | tr -s ' ' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
  export NODE_OPTIONS
fi

exec node --import dd-trace/init.js .output/server/index.mjs
