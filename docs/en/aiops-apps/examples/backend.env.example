# Example — backend/.env (application runtime, never commit)

DATABASE_URL=postgresql+asyncpg://APP_USER:APP_PASSWORD@HOST:5432/my_app_db
DB_HOST=HOST
DB_PORT=5432
DB_NAME=my_app_db
DB_USER=my_app_user
DB_PASSWORD=
DB_SCHEMA=app

APP_NAME=My AIOps API
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:3000

# Admin credentials belong in repository root .env only (bootstrap scripts).
